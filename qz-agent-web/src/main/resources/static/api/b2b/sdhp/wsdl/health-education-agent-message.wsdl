<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://aiqikang.com/sdhp/ws"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             targetNamespace="http://aiqikang.com/sdhp/ws"
             name="HealthEducationAgentMessageService">

    <types>
        <xsd:schema targetNamespace="http://aiqikang.com/sdhp/ws" elementFormDefault="qualified">
            <xsd:element name="receiveMessage">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="messageXml" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="receiveMessageResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="return" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:schema>
    </types>

    <message name="ReceiveMessageRequest">
        <part name="parameters" element="tns:receiveMessage"/>
    </message>

    <message name="ReceiveMessageResponse">
        <part name="parameters" element="tns:receiveMessageResponse"/>
    </message>

    <portType name="HealthEducationAgentMessagePortType">
        <operation name="receiveMessage">
            <input message="tns:ReceiveMessageRequest"/>
            <output message="tns:ReceiveMessageResponse"/>
        </operation>
    </portType>

    <binding name="HealthEducationAgentMessageSoapBinding" type="tns:HealthEducationAgentMessagePortType">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
        <operation name="receiveMessage">
            <soap:operation soapAction="http://aiqikang.com/sdhp/ws/receiveMessage"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
    </binding>

    <service name="HealthEducationAgentMessageService">
        <port name="HealthEducationAgentMessagePort" binding="tns:HealthEducationAgentMessageSoapBinding">
            <soap:address location="http://INTRANET_HOST:INTRANET_PORT/api/b2b/sdhp/ws/health-education-agent-service"/>
        </port>
    </service>
</definitions>
