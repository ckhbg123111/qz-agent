# Copy this file to .env.
# After changes, restart the application process or containers.

# =========================
# Application - Database
# =========================
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/qz_agent?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# =========================
# Application - Redis
# =========================
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=3381
SPRING_REDIS_PASSWORD=
SPRING_REDIS_DATABASE=0

# =========================
# Application - JWT
# =========================
JWT_SECRET=change-me-please
JWT_EXPIRE_SECONDS=3600

# =========================
# Application - Wechat Message API
# =========================
WECHAT_MESSAGE_BASE_URL=https://api.aiqikang.com
WECHAT_MESSAGE_PATH=/api/b2b/wechat/message
WECHAT_MESSAGE_APP_KEY=qzhospital
WECHAT_MESSAGE_APP_SECRET=d98e2ab4fcd4d4e552b37ada2eb3b14e934a6a6b1e2570aea232ac4b228229c3

# =========================
# Application - Wechat Push (SOAP)
# Keep empty if you do not use this integration.
# =========================
WECHAT_PUSH_WSDL_URL=http://192.168.50.19/csp/hsb/DHC.Published.PUB0039.BS.PUB0039.CLS?WSDL=1
WECHAT_PUSH_ENDPOINT_URL=http://192.168.50.19/csp/hsb/DHC.Published.PUB0039.BS.PUB0039.cls
WECHAT_PUSH_NAMESPACE=http://www.dhcc.com.cn
WECHAT_PUSH_SERVICE_NAME=PUB0039
WECHAT_PUSH_PORT_NAME=PUB0039Soap
WECHAT_PUSH_METHOD_NAME=HIPMessageServer
WECHAT_PUSH_SOAP_ACTION=http://www.dhcc.com.cn/DHC.Published.PUB0039.BS.PUB0039.HIPMessageServer
WECHAT_PUSH_BIZCODE=yytz

# =========================
# Application - Logging
# =========================
LOG_PATH=logs

# =========================
# Application - Delayed Push Task
# Production mode: false => report +2 days at 10:00, follow-up +14 days at 10:00
# Test mode: true => report +2 minutes, follow-up +4 minutes
# When test mode is true and fixed patient id is configured, all push chains use this patient id.
# =========================
PUSH_TASK_TEST_MODE=false
PUSH_TASK_TEST_FIXED_PATIENT_ID=
PUSH_TASK_REPORT_DELAY_DAYS=2
PUSH_TASK_FOLLOW_UP_DELAY_DAYS=14
PUSH_TASK_TRIGGER_HOUR=10
PUSH_TASK_REPORT_DELAY_MINUTES_FOR_TEST=2
PUSH_TASK_FOLLOW_UP_DELAY_MINUTES_FOR_TEST=4

# =========================
# Docker Compose - MySQL/Redis side
# =========================
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=qz_agent
REDIS_PASSWORD=

# Optional JVM options for app container
JAVA_OPTS=
